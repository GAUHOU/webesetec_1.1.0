{#
/**
 * @file
 * Block template for "nos_formations" block_1 matching the block wrapper of "nos-cours-block-1".
 */
#}
<section id="block-esetec-views-block-nos-formations-block-1" class="courses pt-120 pb-90 p-relative">
  <!-- Animation Floating Decoration Image (Same wrapper style as nos-cours) -->
  <div class="animations-01">
    <img src="/webesetec_1.1.0/web/themes/custom/esetec/ressources/medias/2023/02/an-img-03.png" alt="animation">
  </div>
  <div class="container">
    <!-- Left-aligned Section Title (Same wrapper style as nos-cours) -->
    <div class="row align-items-center mb-40">
      <div class="col-lg-12 col-md-12 col-sm-12">
        <div class="section-title wow fadeInDown animated" data-animation="fadeInDown" data-delay=".4s">
          <h5><i class="fas fa-graduation-cap"></i> ESETEC FORMATIONS</h5>
          <h2>Nos parcours de formation</h2>
        </div>
      </div>
    </div>
    
    <!-- Block Content (Event Items in 2 Columns Grid) -->
    <div class="block-content">
      {{ content }}
    </div>
  </div>
</section>
