{#
/**
 * @file
 * Template override pour le bloc Nos Meilleurs Atouts / Pourquoi nous choisir (Qeducato Design - Our Best Features).
 */
#}
<section id="{{ plugin_id }}" class="steps-area p-relative fix" style="background-color: #032e3f;">
  <div class="animations-10">
    <img src="{{ '/webesetec_1.1.0/web/' ~ directory ~ '/ressources/medias/2023/03/an-img-10.png' }}" alt="animation image">
  </div>
  <div class="container">
    <div class="row align-items-center">
      
      {# Colonne Gauche (Titre, Description & Liste Verticale des Atouts) #}
      <div class="col-lg-6 col-md-12 col-sm-12">
        <div class="steps-content-wrapper pr-20">
          {{ content.field_nos_meilleurs_atouts }}
        </div>
      </div>

      {# Colonne Droite (Image d'illustration) #}
      <div class="col-lg-6 col-md-12 col-sm-12">
        <div class="step-img">
          {{ content.field_nos_meilleurs_atouts_image }}
        </div>
      </div>

    </div>
  </div>

  {# Transmet les métadonnées et cache tags Drupal pour l'invalidation automatique après modification admin #}
  {{ content|without('field_nos_meilleurs_atouts', 'field_nos_meilleurs_atouts_image') }}
</section>
