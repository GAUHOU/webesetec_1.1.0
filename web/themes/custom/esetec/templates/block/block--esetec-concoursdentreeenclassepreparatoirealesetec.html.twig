{#
/**
 * @file
 * Template override for "Concours d'entrée en classe préparatoire à l'ESETEC" (Qeducato Scholarship CTA 1:1).
 */
#}
<section id="block-esetec-concoursdentreeenclassepreparatoirealesetec" class="cta-area cta-bg pt-60 pb-60 p-relative fix">
  {# Image d'arrière-plan dynamique issue du champ Drupal (field_image_arriere_plan) #}
  {% if content.field_image_arriere_plan %}
    <div class="cta-bg-img">
      {{ content.field_image_arriere_plan }}
    </div>
  {% endif %}

  <div class="cta-bg-overlay"></div>

  <div class="container p-relative" style="z-index: 3;">
    <div class="row align-items-center">
      <div class="col-12">
        <div class="section-title cta-title cta-pub-content">
          {{ content.field_contenu_de_la_pub }}
        </div>
      </div>
    </div>
  </div>
</section>
