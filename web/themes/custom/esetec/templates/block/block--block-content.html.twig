{#
/**
 * @file
 * Default theme implementation for custom content blocks.
 */
#}
{%
  set classes = [
    'block',
    'block-block-content',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label %}
    <h2{{ title_attributes }}>{{ label }}</h2>
  {% endif %}
  {{ title_suffix }}
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
