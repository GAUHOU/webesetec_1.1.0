{#
/**
 * @file
 * Custom block template for Block Nos Engagements.
 * Scoped strictly to #block-esetec-nosengagements matching Qeducato 100vw full-bleed design.
 */
#}
{%
  set classes = [
    'block',
    'block-block-content',
    'block-esetec-nosengagements',
    'steps-area2',
    'p-relative',
    'fix',
    'w-100',
  ]
%}
<section {{ attributes.addClass(classes) }}>
  <div class="animations-02">
    <img src="{{ '/webesetec_1.1.0/web/' ~ directory ~ '/ressources/medias/2023/02/an-img-02.png' }}" alt="animation background">
  </div>
  <div class="container-fluid p-0 g-0 m-0">
    <div class="engagements-full-wrapper">
      {% if engagements_rows is not empty %}
        {% for row in engagements_rows %}
          <div class="row g-0 m-0 engagements-row engagements-row-{{ row.index }}">
            {% if row.is_even %}
              {# Row 2 (Notre Vision): Image LEFT, Text RIGHT #}
              <div class="col-lg-6 col-md-12 engagements-col-img">
                <div class="engagements-img-box">
                  {{ row.img|raw }}
                </div>
              </div>
              <div class="col-lg-6 col-md-12 engagements-col-text">
                <div class="engagements-text-box">
                  <div class="engagements-icon-badge engagements-badge-{{ row.index }}"></div>
                  <div class="engagements-text-inner">
                    {{ row.text|raw }}
                  </div>
                </div>
              </div>
            {% else %}
              {# Row 1 & 3 (Notre Objectif, Notre Mission): Text LEFT, Image RIGHT #}
              <div class="col-lg-6 col-md-12 engagements-col-text">
                <div class="engagements-text-box">
                  <div class="engagements-icon-badge engagements-badge-{{ row.index }}"></div>
                  <div class="engagements-text-inner">
                    {{ row.text|raw }}
                  </div>
                </div>
              </div>
              <div class="col-lg-6 col-md-12 engagements-col-img">
                <div class="engagements-img-box">
                  {{ row.img|raw }}
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>
  </div>
</section>
