{#
/**
 * @file
 * Template override for "Vous trouverez ici toutes les réponses" (Qeducato FAQ Area 1:1 - 100% Dynamic from DB).
 */
#}
<section id="block-esetec-voustrouverezicitouteslesreponses" class="faq-area pt-120 pb-120 p-relative fix">
  <div class="animations-10"><img decoding="async" src="/webesetec_1.1.0/web/themes/custom/esetec/ressources/medias/2023/03/an-img-04.png" alt="an-img-04"></div>
  <div class="animations-08"><img decoding="async" src="/webesetec_1.1.0/web/themes/custom/esetec/ressources/medias/2023/03/an-img-05.png" alt="an-img-05"></div>
  <div class="container">
    <div class="row align-items-center">

      {# Colonne Gauche : Questions / Réponses dynamiques depuis la base de données #}
      <div class="col-lg-7">
        <div class="faq-wrap pr-30 wow fadeInUp animated" data-animation="fadeInUp" data-delay=".4s">
          <div class="block-content">
            {{ content.field_information_de_reponses_qu }}
          </div>
        </div>
      </div>

      {# Colonne Droite : Image d'illustration dynamique depuis la base de données #}
      <div class="col-lg-5">
        <div class="faq-img-box text-center wow fadeInRight animated" data-animation="fadeInRight" data-delay=".4s">
          {{ content.field_image_de_reponses_question }}
        </div>
      </div>

    </div>
  </div>

  {# Transmet les métadonnées et cache tags Drupal pour l'invalidation automatique après modification admin #}
  {{ content|without('field_information_de_reponses_qu', 'field_image_de_reponses_question') }}
</section>
