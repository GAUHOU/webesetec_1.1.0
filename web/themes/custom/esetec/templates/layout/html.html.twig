{#
/**
 * @file
 * Theme override for the basic structure of a single Drupal page.
 *
 * Variables:
 * - logged_in: A flag indicating if user is logged in.
 * - root_path: The root path of the current page (e.g., node, admin, user).
 * - node_type: The content type for the current node, if the page is a node.
 * - head_title: List of text elements that make up the head_title variable.
 *   May contain one or more of the following:
 *   - title: The title of the page.
 *   - name: The name of the site.
 *   - slogan: The slogan of the site.
 * - page_top: Initial rendered markup. This should be printed before 'page'.
 * - page: The rendered page markup.
 * - page_bottom: Closing rendered markup. This variable should be printed after
 *   'page'.
 * - db_offline: A flag indicating if the database is offline.
 * - placeholder_token: The token for generating head, css, js and js-bottom
 *   placeholders.
 *
 * @see template_preprocess_html()
 */
#}
{# Add class to body #}
{%
  set body_classes = [
    not root_path ? 'homepage' : 'inner-page',
    slider_show and not root_path ? 'slider-page',
    node_type ? 'page-type-' ~ node_type|clean_class,
    not page.sidebar_first and not page.sidebar_second ? 'no-sidebar',
    page.sidebar_first and not page.sidebar_second ? 'one-sidebar sidebar-left',
    page.sidebar_second and not page.sidebar_first ? 'one-sidebar sidebar-right',
    page.sidebar_first and page.sidebar_second ? 'two-sidebar'
  ]
%}
<!DOCTYPE html>
<html{{ html_attributes }}>
  <head>
    <head-placeholder token="{{ placeholder_token }}">
    <title>{{ head_title|safe_join(' | ') }}</title>
    {% if font_src == 'local' %}
    <link rel="preload" as="font" href="{{ base_path ~ directory }}/fonts/roboto.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ base_path ~ directory }}/fonts/roboto3.woff2" type="font/woff2" crossorigin>
    <link rel="preload" as="font" href="{{ base_path ~ directory }}/fonts/roboto7.woff2" type="font/woff2" crossorigin>
    {% elseif font_src == 'googlecdn' %}
<link rel="preconnect" href="//fonts.googleapis.com">
<link rel="preconnect" href="//fonts.gstatic.com" crossorigin>
<link href="//fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    {% endif %}
    <css-placeholder token="{{ placeholder_token }}">
    <js-placeholder token="{{ placeholder_token }}">
{% if styling %}
<style>
{{ styling_code | raw }}
</style>
{% endif %}
  </head>
  <body{{ attributes.addClass(body_classes) }}>
    {#
      Keyboard navigation/accessibility link to main content section in
      page.html.twig.
    #}
    <a href="#main-content" class="visually-hidden focusable">
      {{ 'Skip to main content'|t }}
    </a>
    {{ page_top }}
    {{ page }}
    {{ page_bottom }}
    {% if font_src == 'local' %}
      {{ attach_library('esetec/googlefontslocal') }}
    {% endif %}
    <js-bottom-placeholder token="{{ placeholder_token }}">
    {% if is_front and slider_show %}
    <script>
    if (typeof jQuery !== 'undefined') {
      jQuery(document).ready(function($) {
        if (typeof WOW === 'function') {
          new WOW({ live: false }).init();
        }
        if (typeof $.fn.Morphist === 'function' && $(".js-rotating").length) {
          $(".js-rotating").Morphist({
            animateIn: 'fadeInUp',
            animateOut: 'fadeOutLeft',
            speed: {{ slider_speed ?: 5000 }},
          });
        }
        function doSliderAnimations(elements) {
          var animationEndEvents = 'webkitAnimationEnd mozAnimationEnd MSAnimationEnd oanimationend animationend';
          elements.each(function() {
            var $this = $(this);
            var $animationDelay = $this.data('delay');
            var $animationType = 'animated ' + $this.data('animation');
            $this.css({
              'animation-delay': $animationDelay,
              '-webkit-animation-delay': $animationDelay
            });
            $this.addClass($animationType).one(animationEndEvents, function() {
              $this.removeClass($animationType);
            });
          });
        }
        if (typeof $.fn.slick === 'function' && $('.slider-active').length && !$('.slider-active').hasClass('slick-initialized')) {
          var $slider = $('.slider-active');
          $slider.on('init', function(e, slick) {
            var $firstAnimatingElements = $('.single-slider:first-child').find('[data-animation]');
            doSliderAnimations($firstAnimatingElements);
          });
          $slider.on('beforeChange', function(e, slick, currentSlide, nextSlide) {
            var $animatingElements = $('.single-slider[data-slick-index="' + nextSlide + '"]').find('[data-animation]');
            doSliderAnimations($animatingElements);
          });
          $slider.slick({
            autoplay: true,
            autoplaySpeed: {{ slider_speed ?: 5000 }},
            dots: false,
            fade: true,
            arrows: true,
            prevArrow: '<button type="button" class="slick-prev"><i class="far fa-angle-left"></i></button>',
            nextArrow: '<button type="button" class="slick-next"><i class="far fa-angle-right"></i></button>'
          });
          /* Démarrage garanti au chargement initial de la page */
          doSliderAnimations($('.single-slider:first-child [data-animation], .single-slider.slick-active [data-animation]'));
        }
      });
    }
    </script>
    {% endif %}
  </body>
</html>
