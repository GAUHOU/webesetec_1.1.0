{#
/**
 * @file
 * Template implementation for "nos_actualites" content type matching Qeducato 1:1 Single Blog Details 2-column layout.
 */
#}
{%
  set classes = [
    'node',
    'node-type-nos-actualites',
    'node-view-mode-' ~ view_mode|clean_class,
    'inner-blog',
    'b-details-p',
    'pt-40',
    'pb-90',
  ]
%}
<article{{ attributes.addClass(classes) }}>
  <div class="container">
    <div class="row">

      <!-- Left Main Column: Article Content (col-lg-8) -->
      <div class="col-lg-8 col-md-12 col-sm-12">
        <div class="bsingle__post mb-50">
          <div class="bsingle__content">

            {% if display_submitted %}
              <div class="meta-info">
                <ul>
                  <li><i class="far fa-user"></i> Par {{ author_name }}</li>
                  <li><i class="far fa-calendar-alt"></i> {{ node.getCreatedTime|date('j M Y') }}</li>
                  <li><i class="far fa-comments"></i> Actualités</li>
                </ul>
              </div>
            {% endif %}

            <div{{ content_attributes.addClass('node-content', 'details__content') }}>
              {{ content|without('field_image_actualite', 'field_description_actualite') }}
            </div>

            <!-- Post Tags / Keywords -->
            <div class="post-tags-box mt-35">
              <h4 class="tag-title">Mots-clés :</h4>
              <div class="tag-cloud">
                <a href="#" class="tag-link">ESETEC</a>
                <a href="#" class="tag-link">Actualités</a>
                <a href="#" class="tag-link">Yamoussoukro</a>
                <a href="#" class="tag-link">Formation</a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Right Column: Qeducato Blog Sidebar (col-lg-4) -->
      <div class="col-lg-4 col-md-12 col-sm-12">
        <aside class="sidebar-widget">

          <!-- Widget 1: Follow Us -->
          <section class="widget widget_social">
            <h2 class="widget-title">Suivez-nous</h2>
            <div class="widget-social">
              <a href="#" title="Facebook"><i class="fab fa-facebook-f"></i></a>
              <a href="#" title="Twitter"><i class="fab fa-twitter"></i></a>
              <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
              <a href="#" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
              <a href="#" title="YouTube"><i class="fab fa-youtube"></i></a>
            </div>
          </section>

          <!-- Widget 2: Recent Posts (Max 4, excluding current article) -->
          {% if recent_posts is not empty %}
            <section class="widget recent-posts-widget">
              <h2 class="widget-title">Articles Récents</h2>
              <div class="rpwwt-widget">
                <ul>
                  {% for item in recent_posts %}
                    <li>
                      <a href="{{ item.url }}">
                        {% if item.image %}
                          <img width="80" height="60" src="{{ item.image }}" class="wp-post-image" alt="{{ item.title }}" />
                        {% endif %}
                        <span class="rpwwt-post-title">{{ item.title }}</span>
                      </a>
                      <div class="rpwwt-post-date">{{ item.date }}</div>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </section>
          {% endif %}

          <!-- Widget 4: About Us -->
          <section class="widget widget_about">
            <h2 class="widget-title">À Propos de l'ESETEC</h2>
            <div class="sidebar-about-content text-center">
              <img src="{{ base_path }}sites/default/files/logo-trp_2_0.png" alt="ESETEC" class="sidebar-about-logo" />
              <h5 class="title mt-15">ESETEC Yamoussoukro</h5>
              <p>École Supérieure d’Enseignement Technique et Commercial de Yamoussoukro. Formation de cadres supérieurs qualifiés.</p>
            </div>
          </section>

          <!-- Widget 5: Categories -->
          <section class="widget widget_categories">
            <h2 class="widget-title">Catégories</h2>
            <ul>
              <li class="cat-item"><a href="#">Vie Estudiantine</a> <span class="cat-count">(4)</span></li>
              <li class="cat-item"><a href="#">Infrastructures</a> <span class="cat-count">(2)</span></li>
              <li class="cat-item"><a href="#">Partenariats</a> <span class="cat-count">(5)</span></li>
              <li class="cat-item"><a href="#">Événements</a> <span class="cat-count">(6)</span></li>
            </ul>
          </section>

          <!-- Widget 6: Tags -->
          <section class="widget widget_tags">
            <h2 class="widget-title">Mots-clés</h2>
            <div class="tagcloud">
              <a href="#" class="tag-cloud-link">ESETEC</a>
              <a href="#" class="tag-cloud-link">Finance</a>
              <a href="#" class="tag-cloud-link">Yamoussoukro</a>
              <a href="#" class="tag-cloud-link">Recherche</a>
              <a href="#" class="tag-cloud-link">Enseignement</a>
            </div>
          </section>

        </aside>
      </div>

    </div>
  </div>
</article>
