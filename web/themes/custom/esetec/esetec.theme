use Drupal\file\Entity\File;
/**
 * Sanitise input urls.
 */
function santise_val_url($url) {
	if (!empty($url)) {
		// Sanitise (remove all illegal characters) from url.
		$url = filter_var($url, FILTER_SANITIZE_URL);

		// Validate url.
		if (filter_var($url, FILTER_VALIDATE_URL) == TRUE) {
			return $url;
		} else {
			return '#';
		}
	}
	return '';
}
/**
 * Helper function to clean NULL placeholder arguments in TranslatableMarkup.
 */
function _esetec_sanitize_translatable_markup($markup) {
  if ($markup instanceof \Drupal\Core\StringTranslation\TranslatableMarkup) {
    $arguments = $markup->getArguments();
    $modified = FALSE;
    foreach ($arguments as $arg_key => $arg_val) {
      if ($arg_val === NULL) {
        $arguments[$arg_key] = '';
        $modified = TRUE;
      }
    }
    if ($modified) {
      return new \Drupal\Core\StringTranslation\TranslatableMarkup(
        $markup->getUntranslatedString(),
        $arguments,
        $markup->getOptions()
      );
    }
  }
  return $markup;
}

function esetec_preprocess_html(&$variables) {
	$variables['base_path'] = base_path();
	$variables['esetec_path'] = \Drupal::service('extension.list.theme')->getPath('esetec');
	$variables['font_src'] = theme_get_setting('font_src', 'esetec') ?? '';
	$variables['styling'] = theme_get_setting('styling', 'esetec') ?? '';
	$variables['styling_code'] = theme_get_setting('styling_code', 'esetec') ?? '';
	$variables['slider_show'] = theme_get_setting('slider_show', 'esetec') ?? '';
	$variables['slider_speed'] = theme_get_setting('slider_speed', 'esetec') ?? '';

	if (isset($variables['page']['#title'])) {
		$variables['page']['#title'] = _esetec_sanitize_translatable_markup($variables['page']['#title']);
	}
}
