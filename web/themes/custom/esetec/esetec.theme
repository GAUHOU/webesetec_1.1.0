	$variables['header_width'] = theme_get_setting('header_width', 'esetec');
	$variables['main_width'] = theme_get_setting('main_width', 'esetec');
	$variables['footer_width'] = theme_get_setting('footer_width', 'esetec');

	// homepage slider
	$variables['slider_show'] = theme_get_setting('slider_show', 'esetec');
	$variables['slider_speed'] = theme_get_setting('slider_speed', 'esetec') ?: 5000;

	// Slide 1
	$variables['slider_image_1'] = _esetec_get_setting_image_url('slider_image_1');
	$variables['slider_title_1'] = theme_get_setting('slider_title_1', 'esetec') ?: 'welcome To Qeducato';
	$variables['slider_heading_1'] = theme_get_setting('slider_heading_1', 'esetec') ?: 'Education is the best key success in life';
	$variables['slider_desc_1'] = theme_get_setting('slider_desc_1', 'esetec') ?: 'Donec vitae libero non enim placerat eleifend aliquam erat volutpat. Curabitur diam ex, dapibus purus sapien, cursus sed nisl tristique, commodo gravida lectus non.';
	$variables['slider_btn1_text_1'] = theme_get_setting('slider_btn1_text_1', 'esetec') ?: 'Discover More';
	$variables['slider_btn1_link_1'] = theme_get_setting('slider_btn1_link_1', 'esetec') ?: 'a-propos';
	$variables['slider_btn2_text_1'] = theme_get_setting('slider_btn2_text_1', 'esetec') ?: 'Contact Us';
	$variables['slider_btn2_link_1'] = theme_get_setting('slider_btn2_link_1', 'esetec') ?: 'contact';

	// Slide 2
	$variables['slider_image_2'] = _esetec_get_setting_image_url('slider_image_2');
	$variables['slider_title_2'] = theme_get_setting('slider_title_2', 'esetec') ?: 'welcome To Qeducato';
	$variables['slider_heading_2'] = theme_get_setting('slider_heading_2', 'esetec') ?: 'Education is the best key success in life';
	$variables['slider_desc_2'] = theme_get_setting('slider_desc_2', 'esetec') ?: 'Donec vitae libero non enim placerat eleifend aliquam erat volutpat. Curabitur diam ex, dapibus purus sapien, cursus sed nisl tristique, commodo gravida lectus non.';
	$variables['slider_btn1_text_2'] = theme_get_setting('slider_btn1_text_2', 'esetec') ?: 'Discover More';
	$variables['slider_btn1_link_2'] = theme_get_setting('slider_btn1_link_2', 'esetec') ?: 'a-propos';
	$variables['slider_btn2_text_2'] = theme_get_setting('slider_btn2_text_2', 'esetec') ?: 'Contact Us';
	$variables['slider_btn2_link_2'] = theme_get_setting('slider_btn2_link_2', 'esetec') ?: 'contact';

	// Slide 3
	$variables['slider_image_3'] = _esetec_get_setting_image_url('slider_image_3');
	$variables['slider_title_3'] = theme_get_setting('slider_title_3', 'esetec') ?: 'welcome To Qeducato';
	$variables['slider_heading_3'] = theme_get_setting('slider_heading_3', 'esetec') ?: 'Education is the best key success in life';
	$variables['slider_desc_3'] = theme_get_setting('slider_desc_3', 'esetec') ?: 'Donec vitae libero non enim placerat eleifend aliquam erat volutpat. Curabitur diam ex, dapibus purus sapien, cursus sed nisl tristique, commodo gravida lectus non.';
	$variables['slider_btn1_text_3'] = theme_get_setting('slider_btn1_text_3', 'esetec') ?: 'Discover More';
	$variables['slider_btn1_link_3'] = theme_get_setting('slider_btn1_link_3', 'esetec') ?: 'a-propos';
	$variables['slider_btn2_text_3'] = theme_get_setting('slider_btn2_text_3', 'esetec') ?: 'Contact Us';
	$variables['slider_btn2_link_3'] = theme_get_setting('slider_btn2_link_3', 'esetec') ?: 'contact';

