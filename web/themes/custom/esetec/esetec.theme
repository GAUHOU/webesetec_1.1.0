	$variables['slider_card1_desc'] = theme_get_setting('slider_card1_desc', 'esetec') ?: 'Seamlessly visualize quality ellectual capital without superior collaboration and idea sharing listically';
	$variables['slider_card1_link'] = theme_get_setting('slider_card1_link', 'esetec') ?: 'a-propos';
	$variables['slider_card1_btn_text'] = theme_get_setting('slider_card1_btn_text', 'esetec') ?: 'En savoir plus';

	$variables['slider_card2_title'] = theme_get_setting('slider_card2_title', 'esetec') ?: 'International Hubs';
	$variables['slider_card2_desc'] = theme_get_setting('slider_card2_desc', 'esetec') ?: 'Seamlessly visualize quality ellectual capital without superior collaboration and idea sharing listically';
	$variables['slider_card2_link'] = theme_get_setting('slider_card2_link', 'esetec') ?: 'a-propos';
	$variables['slider_card2_btn_text'] = theme_get_setting('slider_card2_btn_text', 'esetec') ?: 'En savoir plus';

	$variables['slider_card3_title'] = theme_get_setting('slider_card3_title', 'esetec') ?: 'Bachelor’s and Master’s';
	$variables['slider_card3_desc'] = theme_get_setting('slider_card3_desc', 'esetec') ?: 'Seamlessly visualize quality ellectual capital without superior collaboration and idea sharing listically';
