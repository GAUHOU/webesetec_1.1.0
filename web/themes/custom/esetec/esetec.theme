}

/**
 * Helper function to retrieve uploaded image URL from theme settings.
 */
function _esetec_get_setting_image_url($setting_name, $default_url = '') {
  $file_setting = theme_get_setting($setting_name, 'esetec');
  $fid = NULL;
  if (is_array($file_setting) && !empty($file_setting[0])) {
    $fid = $file_setting[0];
  }
  elseif (!empty($file_setting) && (is_numeric($file_setting) || is_string($file_setting))) {
    $fid = $file_setting;
  }
  if ($fid) {
    $file = \Drupal\file\Entity\File::load($fid);
    if ($file) {
      $image_uri = $file->getFileUri();
      return \Drupal::service('file_url_generator')->generateAbsoluteString($image_uri);
    }
  }
  return $default_url;
}

/**
 * Safely preprocess breadcrumb.
 */
function esetec_preprocess_breadcrumb(&$variables) {
  $request = \Drupal::request();
  $route_match = \Drupal::routeMatch();
  $route_object = $route_match->getRouteObject();
  if ($route_object) {
    $page_title = \Drupal::service('title_resolver')->getTitle($request, $route_object);
    if (!empty($page_title)) {
      $title_str = is_object($page_title) || is_string($page_title) ? (string) $page_title : '';
      if ($title_str !== '') {
        $variables['breadcrumb'][] = [
          'text' => $title_str,
        ];
        $variables['#cache']['contexts'][] = 'url';
      }
    }
  }
  $variables['breadcrumb_icon_style'] = '/';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block templates.
 */
function esetec_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (isset($variables['elements']['content']['#block_content'])) {
    $block_content = $variables['elements']['content']['#block_content'];
    $bundle = $block_content->bundle();
    $suggestions[] = 'block__block_content__' . $bundle;
  }
}