	$variables['sidebar_width_left'] = theme_get_setting('sidebar_width_left', 'esetec') ?? '';
	$variables['sidebar_width_right'] = theme_get_setting('sidebar_width_right', 'esetec') ?? '';

	// Footer
	$variables['copyright_text'] = theme_get_setting('copyright_text', 'esetec') ?: 1;
	$variables['site_name'] = \Drupal::config('system.site')->get('name') ?: 'ESETEC';

	// content
	$variables['rtl'] = theme_get_setting('rtl', 'esetec') ?? '';

	// Social
	$variables['social_icons_show'] = theme_get_setting('social_icons_show', 'esetec') ?? '';
	$variables['facebook_url'] = santise_val_url(theme_get_setting('facebook_url', 'esetec'));
	$variables['twitter_url'] = santise_val_url(theme_get_setting('twitter_url', 'esetec'));
	$variables['instagram_url'] = santise_val_url(theme_get_setting('instagram_url', 'esetec'));
	$variables['linkedin_url'] = santise_val_url(theme_get_setting('linkedin_url', 'esetec'));
	$variables['youtube_url'] = santise_val_url(theme_get_setting('youtube_url', 'esetec'));
	$variables['vimeo_url'] = santise_val_url(theme_get_setting('vimeo_url', 'esetec'));
  	$variables['telegram_url'] = santise_val_url(theme_get_setting('telegram_url', 'esetec'));
  	$variables['whatsapp_url'] = santise_val_url(theme_get_setting('whatsapp_url', 'esetec'));
  	$variables['github_url'] = santise_val_url(theme_get_setting('github_url', 'esetec'));
	$variables['vk_url'] = santise_val_url(theme_get_setting('vk_url', 'esetec'));

	// Typography
	$variables['body_font_size'] = theme_get_setting('body_font_size', 'esetec') ?? '';

	// Element -> Header menu
	$variables['main_menu_default'] = theme_get_setting('main_menu_default', 'esetec') ?? '';
	$variables['main_menu_top_size'] = theme_get_setting('main_menu_top_size', 'esetec') ?? '';
	$variables['main_menu_top_weight'] = theme_get_setting('main_menu_top_weight', 'esetec') ?? '';
	$variables['main_menu_top_transform'] = theme_get_setting('main_menu_top_transform', 'esetec') ?? '';
	$variables['main_menu_sub_size'] = theme_get_setting('main_menu_sub_size', 'esetec') ?? '';
	$variables['main_menu_sub_weight'] = theme_get_setting('main_menu_sub_weight', 'esetec') ?? '';
	$variables['main_menu_sub_transform'] = theme_get_setting('main_menu_sub_transform', 'esetec') ?? '';
	
	// Element -> Page title
	$variables['page_title_default'] = theme_get_setting('page_title_default', 'esetec') ?? '';
	$variables['page_title_size'] = theme_get_setting('page_title_size', 'esetec') ?? '';
	$variables['page_title_transform'] = theme_get_setting('page_title_transform', 'esetec') ?? '';

	// Components -> Font icons
	$variables['fontawesome_four'] = theme_get_setting('fontawesome_four', 'esetec') ?? '';
	$variables['fontawesome_five'] = theme_get_setting('fontawesome_five', 'esetec') ?? '';
	$variables['bootstrapicons'] = theme_get_setting('bootstrapicons', 'esetec') ?? '';
	
	// Components -> scroll to top
	$variables['scrolltotop_on'] = theme_get_setting('scrolltotop_on', 'esetec') ?? '';
	
	// Comment
	$variables['highlight_author_comment'] = theme_get_setting('highlight_author_comment', 'esetec') ?? '';
}
/**
 * Node preprocess.
 */
function esetec_preprocess_node(array &$variables) {
	$variables['node_author_pic'] = theme_get_setting('node_author_pic', 'esetec');
	$variables['node_tags'] = theme_get_setting('node_tags', 'esetec');

	$node = $variables['node'] ?? NULL;
	if ($node && $node->bundle() === 'nos_actualites') {
		$current_nid = $node->id();
		$query = \Drupal::entityQuery('node')
			->accessCheck(FALSE)
			->condition('type', 'nos_actualites')
			->condition('status', 1)
			->condition('nid', $current_nid, '<>')
			->sort('created', 'DESC')
			->range(0, 4);
		$nids = $query->execute();

		$recent_posts = [];
		if (!empty($nids)) {
			$nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
			foreach ($nodes as $n) {
				$img_src = '';
				if ($n->hasField('field_contenu_de_l_actualite') && !$n->get('field_contenu_de_l_actualite')->isEmpty()) {
					$body = $n->get('field_contenu_de_l_actualite')->value;
					if (preg_match('/<img[^>]+src=["\']([^"\']+)["\']/i', $body, $matches)) {
						$img_src = $matches[1];
					}
				}
				$recent_posts[] = [
					'title' => $n->getTitle(),
					'url' => $n->toUrl()->toString(),
					'date' => date('j M Y', $n->getCreatedTime()),
					'image' => $img_src,
				];
			}
		}
		$variables['recent_posts'] = $recent_posts;
	}
}

/**
 * Comment preprocess.
 */
function esetec_preprocess_comment(array &$variables) {
	$variables['comment_user_pic'] = theme_get_setting('comment_user_pic', 'esetec');
}

/**
 * Helper function to retrieve uploaded image URL from theme settings.
 */
function _esetec_get_setting_image_url($setting_name, $default_url = '') {
  $file_setting = theme_get_setting($setting_name, 'esetec');
  $fid = NULL;
  if (is_array($file_setting) && !empty($file_setting[0])) {
    $fid = $file_setting[0];
  }
  elseif (!empty($file_setting) && (is_numeric($file_setting) || is_string($file_setting))) {
    $fid = $file_setting;
  }
  if ($fid) {
    $file = \Drupal\file\Entity\File::load($fid);
    if ($file) {
      $image_uri = $file->getFileUri();
      return \Drupal::service('file_url_generator')->generateAbsoluteString($image_uri);
    }
  }
  return $default_url;
}



/**
 * Implements hook_theme_suggestions_HOOK_alter() for block templates.
 */
function esetec_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (isset($variables['elements']['content']['#block_content'])) {
    $block_content = $variables['elements']['content']['#block_content'];
    $bundle = $block_content->bundle();
    $suggestions[] = 'block__block_content__' . $bundle;
  }
}
