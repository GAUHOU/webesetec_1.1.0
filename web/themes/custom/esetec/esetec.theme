	$variables['header_topbar_show'] = theme_get_setting('header_topbar_show', 'esetec') ?? theme_get_setting('header_phone_show', 'esetec') ?? 1;
	$variables['header_phone'] = theme_get_setting('header_phone', 'esetec') ?: theme_get_setting('header_phone_number', 'esetec') ?: '+225 00 00 00 00';
	$variables['header_email'] = theme_get_setting('header_email', 'esetec') ?: theme_get_setting('header_email_address', 'esetec') ?: 'info@esetec.edu';
	$variables['sticky_header_enable'] = theme_get_setting('sticky_header_enable', 'esetec') ?? theme_get_setting('sticky_header_on', 'esetec') ?? theme_get_setting('sticky_header', 'esetec') ?? 1;

	// Dynamic Language Switcher from Drupal Language Manager
	$language_manager = \Drupal::languageManager();
	$current_language = $language_manager->getCurrentLanguage();
	$languages = $language_manager->getLanguages();

	$route_match = \Drupal::routeMatch();
	$route_name = $route_match->getRouteName() ?: '<current>';
	$route_params = $route_match->getRawParameters()->all();

	$lang_list = [];
	foreach ($languages as $lang_id => $language) {
		try {
			$url = \Drupal\Core\Url::fromRoute($route_name, $route_params, [
				'language' => $language,
			]);
			$link_url = $url->toString();
		} catch (\Exception $e) {
			$link_url = '/' . $lang_id;
		}

		$lang_list[] = [
			'id' => $lang_id,
			'code' => strtoupper($lang_id),
			'name' => $language->getName(),
			'is_current' => ($lang_id === $current_language->getId()),
			'url' => $link_url,
		];
