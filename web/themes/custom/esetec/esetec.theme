<?php
/**
 * @file
 * Extra Functions for Esetec theme.
 */
use Drupal\file\Entity\File;
/**
 * Sanitise input urls.
 */
function santise_val_url($url) {
	if (!empty($url)) {
		// Sanitise (remove all illegal characters) from url.
		$url = filter_var($url, FILTER_SANITIZE_URL);

		// Validate url.
		if (filter_var($url, FILTER_VALIDATE_URL) == TRUE) {
			return $url;
		} else {
			return '#';
		}
	}
	return '';
}
/**
 * Helper function to clean NULL placeholder arguments in TranslatableMarkup.
 */
function _esetec_sanitize_translatable_markup($markup) {
  if ($markup instanceof \Drupal\Core\StringTranslation\TranslatableMarkup) {
    $arguments = $markup->getArguments();
    $modified = FALSE;
    foreach ($arguments as $arg_key => $arg_val) {
      if ($arg_val === NULL) {
        $arguments[$arg_key] = '';
        $modified = TRUE;
      }
    }
    if ($modified) {
      return new \Drupal\Core\StringTranslation\TranslatableMarkup(
        $markup->getUntranslatedString(),
        $arguments,
        $markup->getOptions()
      );
    }
  }
  return $markup;
}

function esetec_preprocess_html(&$variables) {
	$variables['base_path'] = base_path();
	$variables['esetec_path'] = \Drupal::service('extension.list.theme')->getPath('esetec');
	$variables['font_src'] = theme_get_setting('font_src', 'esetec') ?? '';
	$variables['styling'] = theme_get_setting('styling', 'esetec') ?? '';
	$variables['styling_code'] = theme_get_setting('styling_code', 'esetec') ?? '';
	$variables['slider_show'] = theme_get_setting('slider_show', 'esetec') ?? '';
	$variables['slider_speed'] = theme_get_setting('slider_speed', 'esetec') ?? '';

	if (isset($variables['page']['#title'])) {
		$variables['page']['#title'] = _esetec_sanitize_translatable_markup($variables['page']['#title']);
	}
}

/**
 * Keeps the editable "Nos meilleurs atouts" block fresh for every request.
 *
 * Its text and image are managed as block-content fields.  Disabling only this
 * render cache prevents a stale fragment from being shown after an editor saves
 * a new value, without affecting caches for the rest of the site.
 */
function esetec_preprocess_block(array &$variables): void {
  if (!empty($variables['site_logo'])) {
    $variables['site_logo'] = str_replace('http://:./', '/webesetec_1.1.0/web/', (string) $variables['site_logo']);
  }

  if (($variables['plugin_id'] ?? '') === 'block_content:33735641-c7a1-4fc5-94bc-34b6e86eb67e') {
    $variables['elements']['#cache']['max-age'] = 0;
    $variables['content']['#cache']['max-age'] = 0;
  }

  // Custom preprocess for Historique de l'ESETEC block to match Model Image 3
  $block_id = $variables['elements']['#id'] ?? $variables['attributes']['id'] ?? $variables['elements']['#configuration']['id'] ?? '';
  if (str_contains($block_id, 'histoiriquedeesetec') || str_contains($block_id, 'historique')) {
    $variables['#cache']['max-age'] = 0;
    if (isset($variables['content']['field_mots_sur_l_universite_droi'])) {
      $renderer = \Drupal::service('renderer');
      $field_render = $variables['content']['field_mots_sur_l_universite_droi'];
      $rendered_text = (string) $renderer->renderPlain($field_render);
      
      if (!empty($rendered_text)) {
        $dom = new \DOMDocument();
        @$dom->loadHTML(mb_convert_encoding($rendered_text, 'HTML-ENTITIES', 'UTF-8'), LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);
        $xpath = new \DOMXPath($dom);
        $containers = $xpath->query("//div[contains(@class, 'ckeditor-col-container')]");
        
        $container_list = [];
        if ($containers && $containers->length > 0) {
          foreach ($containers as $c) {
            $container_list[] = $dom->saveHTML($c);
          }
        }
        
        if (!empty($container_list)) {
          $variables['container_1'] = $container_list[0] ?? '';
          $variables['container_2'] = $container_list[1] ?? '';
          $variables['remaining_containers'] = array_slice($container_list, 2);
        }
      }
    }
  }

  // Preprocess for Nos Engagements block (Qeducato 100vw Full-Bleed Edge-to-Edge Grid)
  if (str_contains($block_id, 'nosengagements') || str_contains($block_id, 'engagements')) {
    $variables['#cache']['max-age'] = 0;
    if (isset($variables['content']['field_nos_engagementss'])) {
      $renderer = \Drupal::service('renderer');
      $field_render = $variables['content']['field_nos_engagementss'];
      $rendered_text = (string) $renderer->renderPlain($field_render);

      if (!empty($rendered_text)) {
        $dom = new \DOMDocument();
        @$dom->loadHTML(mb_convert_encoding($rendered_text, 'HTML-ENTITIES', 'UTF-8'), LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);
        $xpath = new \DOMXPath($dom);
        $containers = $xpath->query("//div[contains(@class, 'ckeditor-col-container')]");

        $parsed_rows = [];
        if ($containers && $containers->length > 0) {
          $item_index = 0;
          foreach ($containers as $c) {
            $item_index++;
            $cols = $xpath->query(".//div[contains(@class, 'grid-6') or contains(@class, 'col-')]", $c);

            $text_html = '';
            $img_html = '';

            if ($cols && $cols->length >= 1) {
              foreach ($cols as $col) {
                $has_img = $xpath->query(".//img", $col);
                if ($has_img && $has_img->length > 0) {
                  $img_node = $has_img->item(0);
                  $src = $img_node->getAttribute('src');
                  $alt = $img_node->getAttribute('alt');
                  $img_html = '<img src="' . htmlspecialchars($src) . '" alt="' . htmlspecialchars($alt) . '" class="engagements-img-full" />';
                } else {
                  // Extract inner H2/H3 and P content cleanly
                  $inner_html = '';
                  foreach ($col->childNodes as $child) {
                    $inner_html .= $dom->saveHTML($child);
                  }
                  $text_html = trim($inner_html);
                }
              }
            }

            if (!empty($text_html) || !empty($img_html)) {
              $parsed_rows[] = [
                'index' => $item_index,
                'text' => $text_html,
                'img' => $img_html,
                'is_even' => ($item_index % 2 === 0),
              ];
            }
          }
        }

        $variables['engagements_rows'] = $parsed_rows;
      }
    }
  }

  // Preprocess for Hébergement Étudiant block matching 3-column overlapping mockup
  if (str_contains($block_id, 'hebergement') || str_contains($block_id, 'hebergementetudiant')) {
    $variables['#cache']['max-age'] = 0;
    $field_render = $variables['content']['field_contenu_de_hebergement_etu'] ?? null;
    if ($field_render) {
      $renderer = \Drupal::service('renderer');
      $rendered_text = (string) $renderer->renderPlain($field_render);

      if (!empty($rendered_text)) {
        $dom = new \DOMDocument();
        @$dom->loadHTML(mb_convert_encoding($rendered_text, 'HTML-ENTITIES', 'UTF-8'), LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);
        $xpath = new \DOMXPath($dom);

        // Extract images
        $imgs = $xpath->query("//img");
        $img_1 = ($imgs && $imgs->length > 0) ? $imgs->item(0)->getAttribute('src') : '';
        $img_2 = ($imgs && $imgs->length > 1) ? $imgs->item(1)->getAttribute('src') : '';

        // Extract headings
        $headings = $xpath->query("//h1 | //h2 | //h3");
        $title_1 = ($headings && $headings->length > 0) ? trim($headings->item(0)->nodeValue) : '';
        $title_2 = ($headings && $headings->length > 1) ? trim($headings->item(1)->nodeValue) : '';

        // Extract paragraphs
        $paragraphs = $xpath->query("//p");
        $p_list = [];
        if ($paragraphs && $paragraphs->length > 0) {
          foreach ($paragraphs as $p) {
            $val = trim($p->nodeValue);
            if (!empty($val)) {
              $p_list[] = $val;
            }
          }
        }

        $subtitle_1 = $p_list[0] ?? '';
        $text_1 = isset($p_list[1]) ? '<p>' . htmlspecialchars($p_list[1]) . '</p>' : '';
        $text_2 = (isset($p_list[2]) ? '<p><strong>' . htmlspecialchars($p_list[2]) . '</strong></p>' : '') . (isset($p_list[3]) ? '<p>' . htmlspecialchars($p_list[3]) . '</p>' : '');
        
        $remaining_p = array_slice($p_list, 4);
        $text_3 = '';
        foreach ($remaining_p as $rp) {
          $text_3 .= '<p>' . htmlspecialchars($rp) . '</p>';
        }

        $variables['hebergement_data'] = [
          'title_1' => $title_1 ?: 'Hébergement étudiant',
          'subtitle_1' => $subtitle_1,
          'text_1' => $text_1,
          'img_1' => $img_1,
          'img_2' => $img_2,
          'title_2' => $title_2 ?: 'Votre résidence, votre environnement d’études',
          'text_2' => $text_2,
          'text_3' => $text_3,
        ];
      }
    }
  }
}

function esetec_preprocess_breadcrumb(array &$variables): void {
  if (empty($variables['breadcrumb'])) {
    return;
  }
  
  $unique_breadcrumb = [];
  $seen_texts = [];
  
  foreach ($variables['breadcrumb'] as $item) {
    $text = trim(is_string($item['text'] ?? '') ? $item['text'] : (string) ($item['text'] ?? ''));
    if ($text === '') {
      continue;
    }
    $lower = mb_strtolower($text);
    if (!isset($seen_texts[$lower])) {
      $seen_texts[$lower] = true;
      $unique_breadcrumb[] = $item;
    }
  }
  
  $variables['breadcrumb'] = $unique_breadcrumb;
}

